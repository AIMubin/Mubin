{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mubin Review Harness v0.1 (untrusted external-submission envelope)",
  "type": "object", "additionalProperties": false,
  "required": ["contract", "candidate", "deterministic_checks", "review_attempts"],
  "properties": {
    "contract": {"const": "mubin-review-harness-v0.1"},
    "candidate": {"type": "object", "additionalProperties": false,
      "required": ["repository", "base_sha", "head_sha", "changed_paths", "impact_tags"],
      "properties": {
        "repository": {"const": "AIMubin/Mubin"},
        "base_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "head_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "changed_paths": {"type": "array", "minItems": 1, "maxItems": 60, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
        "impact_tags": {"type": "array", "minItems": 1, "maxItems": 11, "items": {"enum": ["documentation", "code_change", "security_boundary", "source_attribution", "external_source", "religious_reasoning", "source_rights", "real_human_identity", "authoritative_scholarly_decision", "frozen_holdout", "release_action"]}}
      }
    },
    "deterministic_checks": {"type": "array", "maxItems": 10,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["check_id", "result", "target_sha", "claimed_run_url"],
        "properties": {
          "check_id": {"enum": ["unit_tests", "negative_tests", "schema_validation", "source_span", "holdout_partition", "code_security"]},
          "result": {"enum": ["pass", "fail", "unknown"]},
          "target_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "claimed_run_url": {"type": "string", "maxLength": 220, "pattern": "^https://github[.]com/AIMubin/Mubin/actions/runs/[0-9]+$"}
        }
      }
    },
    "review_attempts": {"type": "array", "maxItems": 3,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["channel", "attempt_id", "model_label", "target_sha", "verdict", "findings", "origin"],
        "properties": {
          "channel": {"enum": ["code_security", "source_attribution", "methodology_falsifier"]},
          "attempt_id": {"type": "string", "pattern": "^[a-z0-9_-]{3,40}$"},
          "model_label": {"type": "string", "minLength": 1, "maxLength": 80},
          "target_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "origin": {"const": "unverified_external_submission"},
          "verdict": {"enum": ["pass", "fail", "abstain"]},
          "findings": {"type": "array", "maxItems": 20,
            "items": {"type": "object", "additionalProperties": false,
              "required": ["finding_id", "category", "severity", "reproduction_note"],
              "properties": {
                "finding_id": {"type": "string", "pattern": "^[a-z0-9_-]{3,40}$"},
                "category": {"enum": ["security", "provenance", "rights", "speaker_attribution", "semantic_contract", "methodology", "test_coverage", "other"]},
                "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
                "reproduction_note": {"type": "string", "minLength": 8, "maxLength": 1200}
              }
            }
          }
        }
      }
    }
  }
}
