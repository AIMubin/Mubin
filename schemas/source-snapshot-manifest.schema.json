{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AIMubin/Mubin/main/schemas/source-snapshot-manifest.schema.json",
  "title": "Mubin P1 offline source snapshot manifest",
  "description": "Operator-asserted rights plus deterministic local source digest and byte span contract; not a license attestation or scholarly authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "sources"
  ],
  "properties": {
    "contract_version": {
      "const": "0.1.0"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "relative_path",
          "work_title",
          "edition",
          "scope_locator",
          "content_sha256",
          "rights",
          "spans"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
          },
          "relative_path": {
            "type": "string",
            "minLength": 1
          },
          "work_title": {
            "type": "string",
            "minLength": 1
          },
          "edition": {
            "type": "string",
            "minLength": 1
          },
          "scope_locator": {
            "type": "string",
            "minLength": 1
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "rights": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "basis",
              "reference"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "operator_cleared",
                  "restricted",
                  "unknown"
                ]
              },
              "basis": {
                "type": "string",
                "minLength": 1
              },
              "reference": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "spans": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "locator",
                "start_byte",
                "end_byte"
              ],
              "properties": {
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "start_byte": {
                  "type": "integer",
                  "minimum": 0
                },
                "end_byte": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "minItems": 1
          }
        }
      }
    }
  }
}
