{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AIMubin/Mubin/main/schemas/shamela-bibliographic-catalog.schema.json",
  "title": "Mubin S0.1 Shamela Bibliographic Metadata-Only Pilot",
  "description": "Manual official page observations only; explicitly no rights, publisher authenticity, local content acquisition, or religious evidence verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog_version",
    "scope",
    "acquisition",
    "entries"
  ],
  "properties": {
    "catalog_version": {
      "const": "0.1.0"
    },
    "scope": {
      "const": "shamela_bibliographic_metadata_only"
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "database_inspected",
        "text_acquired",
        "rights_verified"
      ],
      "properties": {
        "method": {
          "const": "manual_official_page_review"
        },
        "database_inspected": {
          "const": false
        },
        "text_acquired": {
          "const": false
        },
        "rights_verified": {
          "const": false
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "book_id",
          "discipline",
          "work_title",
          "author_display",
          "edition_display",
          "editor_display",
          "publisher_display",
          "volume_description",
          "pagination_status",
          "book_url",
          "sample_page_url",
          "rights_status",
          "edition_verification",
          "text_acquisition_status",
          "notes",
          "review_flags"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^shamela:book:[1-9][0-9]{0,8}$"
          },
          "book_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999999999
          },
          "discipline": {
            "enum": [
              "hadith",
              "tafsir",
              "usul"
            ]
          },
          "work_title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "author_display": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "edition_display": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "editor_display": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "publisher_display": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "volume_description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "pagination_status": {
            "enum": [
              "site_reports_print_match",
              "site_reports_auto_numbering",
              "not_established"
            ]
          },
          "book_url": {
            "type": "string",
            "pattern": "^https://shamela\\.ws/book/[1-9][0-9]{0,8}$"
          },
          "sample_page_url": {
            "type": "string",
            "pattern": "^https://shamela\\.ws/book/[1-9][0-9]{0,8}/[1-9][0-9]{0,8}$"
          },
          "rights_status": {
            "const": "unverified"
          },
          "edition_verification": {
            "const": "bibliographic_claim_only"
          },
          "text_acquisition_status": {
            "const": "not_acquired"
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "review_flags": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "enum": [
                "multiple_editions",
                "electronic_transcription_edition_sensitive",
                "editorial_interventions",
                "pagination_edition_specific",
                "cross_edition_numbering_risk",
                "bibliographic_description_needs_human_review"
              ]
            }
          }
        }
      }
    }
  }
}
