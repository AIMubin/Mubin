{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AIMubin/Mubin/main/schemas/engine-result-v1.schema.json",
  "title": "Mubin result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "engine",
    "engine_version",
    "status",
    "findings",
    "evidence_refs",
    "uncertainties",
    "errors",
    "provenance",
    "trace_id"
  ],
  "properties": {
    "contract_version": {
      "const": "engine-contract/1.0"
    },
    "request_id": {
      "$ref": "#/$defs/id"
    },
    "engine": {
      "enum": [
        "quran",
        "tafsir",
        "hadith",
        "usul",
        "fiqh"
      ]
    },
    "engine_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "OK",
        "PARTIAL",
        "UNDETERMINED",
        "NO_MATCH",
        "UNAVAILABLE",
        "REJECTED",
        "ERROR"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "maxItems": 1000
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true,
      "maxItems": 128
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 160
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 160
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_ids"
      ],
      "properties": {
        "snapshot_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true,
          "maxItems": 128
        }
      }
    },
    "trace_id": {
      "$ref": "#/$defs/id"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{2,127}$"
    }
  }
}
