{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mubin U0.1 synthetic rule AST",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "scope",
    "symbols",
    "methodologies"
  ],
  "properties": {
    "contract": {
      "const": "mubin-usul-synthetic-rulebook-v1"
    },
    "scope": {
      "const": "synthetic_logic_not_fiqh_fatwa"
    },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,39}$"
      }
    },
    "methodologies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rules"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "rules": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "$ref": "#/$defs/rule"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "id"
          ],
          "properties": {
            "op": {
              "const": "fact"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,39}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "arg"
          ],
          "properties": {
            "op": {
              "const": "not"
            },
            "arg": {
              "$ref": "#/$defs/expression"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "const": "all"
            },
            "args": {
              "type": "array",
              "minItems": 2,
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "const": "any"
            },
            "args": {
              "type": "array",
              "minItems": 2,
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          }
        }
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question_id",
        "when",
        "conclusion"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,39}$"
        },
        "question_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,39}$"
        },
        "when": {
          "$ref": "#/$defs/expression"
        },
        "unless": {
          "$ref": "#/$defs/expression"
        },
        "conclusion": {
          "enum": [
            "track_north",
            "track_south"
          ]
        }
      }
    }
  }
}
