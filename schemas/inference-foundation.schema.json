{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AIMubin/Mubin/main/schemas/inference-foundation.schema.json",
  "title": "Mubin P0 Evidence-Grounded Inference Foundation",
  "description": "Structural-only contract; compliance does not certify Islamic scholarly authority or authenticity.",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "0.1.0"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 1
    },
    "methodologies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/methodology"
      },
      "minItems": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      },
      "minItems": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      },
      "minItems": 1
    },
    "inferences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inference"
      },
      "minItems": 1
    },
    "objections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/objection"
      }
    },
    "proofs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proof"
      },
      "minItems": 1
    },
    "historical_availability": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/historical_availability"
      }
    }
  },
  "required": [
    "contract_version",
    "sources",
    "evidence",
    "methodologies",
    "claims",
    "rules",
    "inferences",
    "objections",
    "proofs",
    "historical_availability"
  ],
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
        },
        "kind": {
          "type": "string",
          "enum": [
            "quran",
            "hadith",
            "usul",
            "fiqh",
            "biography",
            "history",
            "other"
          ]
        },
        "work_title": {
          "type": "string",
          "minLength": 1
        },
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "kind",
        "work_title",
        "edition",
        "locator",
        "content_sha256"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        },
        "excerpt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "verified",
            "unverified",
            "rejected"
          ]
        },
        "verification_method": {
          "type": "string",
          "enum": [
            "exact_source_match",
            "human_source_check",
            "unverified"
          ]
        }
      },
      "required": [
        "id",
        "source_id",
        "locator",
        "excerpt",
        "excerpt_sha256",
        "verification_status",
        "verification_method"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "verification_status": {
                "const": "verified"
              }
            },
            "required": [
              "verification_status"
            ]
          },
          "then": {
            "properties": {
              "verification_method": {
                "enum": [
                  "exact_source_match",
                  "human_source_check"
                ]
              }
            }
          }
        }
      ]
    },
    "methodology": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "label",
        "version",
        "source_evidence_ids"
      ],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "claim_type": {
          "type": "string",
          "enum": [
            "source_attributed",
            "inferred"
          ]
        },
        "conclusion_kind": {
          "type": "string",
          "enum": [
            "source_derived",
            "rule_derived",
            "qiyas_derived"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
          },
          "uniqueItems": true
        },
        "inference_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
        },
        "modality": {
          "type": "string",
          "enum": [
            "actual",
            "counterfactual"
          ]
        },
        "assessment_status": {
          "type": "string",
          "enum": [
            "no_recorded_objection",
            "contested",
            "undetermined"
          ]
        },
        "counterfactual_context": {
          "$ref": "#/$defs/counterfactual_context"
        }
      },
      "required": [
        "id",
        "statement",
        "claim_type",
        "conclusion_kind",
        "evidence_ids",
        "modality",
        "assessment_status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "modality": {
                "const": "counterfactual"
              }
            },
            "required": [
              "modality"
            ]
          },
          "then": {
            "required": [
              "counterfactual_context"
            ],
            "properties": {
              "claim_type": {
                "const": "inferred"
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "counterfactual_context"
              ]
            }
          }
        }
      ]
    },
    "rule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
        },
        "methodology_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
        },
        "rule_type": {
          "type": "string",
          "enum": [
            "deduction",
            "qiyas",
            "tarjih",
            "constraint",
            "exception"
          ]
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
          },
          "uniqueItems": true
        },
        "formalization_status": {
          "type": "string",
          "enum": [
            "draft",
            "machine_checkable"
          ]
        }
      },
      "required": [
        "id",
        "methodology_id",
        "rule_type",
        "expression",
        "preconditions",
        "exceptions",
        "source_evidence_ids",
        "formalization_status"
      ],
      "additionalProperties": false
    },
    "exception_check": {
      "type": "object",
      "properties": {
        "exception": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "enum": [
            "cleared",
            "triggered",
            "unknown"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "exception",
        "outcome",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "qiyas_elements": {
      "type": "object",
      "properties": {
        "asl": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
        },
        "far": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
        },
        "hukm_al_asl": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
        },
        "illah": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
        }
      },
      "required": [
        "asl",
        "far",
        "hukm_al_asl",
        "illah"
      ],
      "additionalProperties": false
    },
    "inference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
        },
        "inference_kind": {
          "type": "string",
          "enum": [
            "deduction",
            "qiyas",
            "tarjih"
          ]
        },
        "methodology_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
        },
        "rule_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "premise_claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "conclusion_claim_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
        },
        "exception_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exception_check"
          }
        },
        "qiyas_elements": {
          "$ref": "#/$defs/qiyas_elements"
        }
      },
      "required": [
        "id",
        "inference_kind",
        "methodology_id",
        "rule_ids",
        "premise_claim_ids",
        "conclusion_claim_id",
        "exception_checks"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "inference_kind": {
                "const": "qiyas"
              }
            },
            "required": [
              "inference_kind"
            ]
          },
          "then": {
            "required": [
              "qiyas_elements"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "inference_kind": {
                "enum": [
                  "deduction",
                  "tarjih"
                ]
              }
            },
            "required": [
              "inference_kind"
            ]
          },
          "then": {
            "not": {
              "required": [
                "qiyas_elements"
              ]
            }
          }
        }
      ]
    },
    "objection": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
        },
        "target_inference_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
        },
        "objection_kind": {
          "type": "string",
          "enum": [
            "counterexample",
            "contrary_evidence",
            "invalid_analogy",
            "missing_illah",
            "alternative_reading",
            "historical_uncertainty"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "answered",
            "sustained"
          ]
        }
      },
      "required": [
        "id",
        "target_inference_id",
        "objection_kind",
        "statement",
        "evidence_ids",
        "status"
      ],
      "additionalProperties": false
    },
    "proof": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
        },
        "conclusion_claim_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
        },
        "inference_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "methodology_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
        },
        "verification_scope": {
          "const": "structural_only"
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "structurally_checked",
            "blocked",
            "undetermined"
          ]
        }
      },
      "required": [
        "id",
        "conclusion_claim_id",
        "inference_ids",
        "methodology_id",
        "verification_scope",
        "verification_status"
      ],
      "additionalProperties": false
    },
    "historical_availability": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
        },
        "scholar_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
        },
        "evidence_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
        },
        "knowledge_state": {
          "type": "string",
          "enum": [
            "attested_reached",
            "attested_not_reached",
            "unknown"
          ]
        },
        "basis_type": {
          "type": "string",
          "enum": [
            "explicit_historical_testimony",
            "documented_chronological_impossibility",
            "none"
          ]
        },
        "basis_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:-]{2,127}(?![\\s\\S])"
          },
          "uniqueItems": true
        },
        "statement": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "scholar_id",
        "evidence_id",
        "knowledge_state",
        "basis_type",
        "basis_evidence_ids",
        "statement"
      ],
      "additionalProperties": false
    },
    "counterfactual_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scholar_id": {
          "$ref": "#/$defs/identifier"
        },
        "historical_availability_id": {
          "$ref": "#/$defs/identifier"
        },
        "assumed_evidence_id": {
          "$ref": "#/$defs/identifier"
        },
        "assumption": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "scholar_id",
        "historical_availability_id",
        "assumed_evidence_id",
        "assumption"
      ]
    }
  }
}
