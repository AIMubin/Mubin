{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AIMubin/Mubin/main/schemas/hadith-witness-identity-v1.schema.json",
  "title": "Mubin B02-C.6: Hadith witness textual identity research, not scholarly authentication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "case_id",
    "hsearch_bridge",
    "candidate_fragment",
    "witnesses",
    "open_objection_ids"
  ],
  "properties": {
    "contract": {
      "const": "mubin-hadith-witness-identity/1.0"
    },
    "case_id": {
      "$ref": "#/$defs/id"
    },
    "hsearch_bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "link_id",
        "classification",
        "receipt_sha256"
      ],
      "properties": {
        "link_id": {
          "$ref": "#/$defs/id"
        },
        "classification": {
          "const": "NARRATION_FRAGMENT_CANDIDATE"
        },
        "receipt_sha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "candidate_fragment": {
      "$ref": "#/$defs/span"
    },
    "witnesses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "source_id",
          "work_id",
          "source_sha256",
          "version_ref",
          "locator",
          "segment_type",
          "segment",
          "context"
        ],
        "properties": {
          "role": {
            "enum": [
              "candidate",
              "comparison"
            ]
          },
          "source_id": {
            "$ref": "#/$defs/source_token"
          },
          "work_id": {
            "$ref": "#/$defs/source_token"
          },
          "source_sha256": {
            "$ref": "#/$defs/sha"
          },
          "version_ref": {
            "$ref": "#/$defs/source_token"
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "segment_type": {
            "enum": [
              "MATN_CANDIDATE",
              "QURAN_QUOTE",
              "COMMENTARY",
              "UNCLASSIFIED"
            ]
          },
          "segment": {
            "$ref": "#/$defs/span"
          },
          "context": {
            "$ref": "#/$defs/span"
          },
          "isnad": {
            "$ref": "#/$defs/span"
          }
        }
      }
    },
    "open_objection_ids": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{2,127}$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_byte",
        "end_byte",
        "sha256"
      ],
      "properties": {
        "start_byte": {
          "type": "integer",
          "minimum": 0
        },
        "end_byte": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "source_token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    }
  }
}
