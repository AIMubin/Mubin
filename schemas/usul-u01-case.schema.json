{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mubin U0.1 synthetic case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "case_id",
    "methodology_id",
    "question_id",
    "facts"
  ],
  "properties": {
    "contract": {
      "const": "mubin-usul-synthetic-case-v1"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,39}$"
    },
    "methodology_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,39}$"
    },
    "question_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,39}$"
    },
    "facts": {
      "type": "object",
      "minProperties": 0,
      "maxProperties": 32,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,39}$"
      },
      "additionalProperties": {
        "enum": [
          "established",
          "refuted",
          "unknown"
        ]
      }
    }
  }
}
