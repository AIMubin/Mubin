{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AIMubin/Mubin/main/schemas/parent-window-binding.schema.json",
  "title": "Mubin P1.1 parent-pinned derived quote window",
  "description": "Local byte consistency of a declared parent pin and derived quote window; NOT source origin, licensing or religious accuracy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "scope",
    "parent",
    "window",
    "quote",
    "authority",
    "binding_sha256"
  ],
  "properties": {
    "contract_version": {
      "const": "0.1.0"
    },
    "scope": {
      "const": "parent_pinned_window_only"
    },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "work_id",
        "version_id",
        "repo_ref",
        "source_path",
        "git_blob_sha1",
        "source_sha256",
        "size_bytes",
        "quote_start_byte",
        "quote_end_byte"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "work_id": {
          "type": "string",
          "minLength": 1
        },
        "version_id": {
          "type": "string",
          "minLength": 1
        },
        "repo_ref": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "git_blob_sha1": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "quote_start_byte": {
          "type": "integer",
          "minimum": 0
        },
        "quote_end_byte": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "absolute_start_byte",
        "absolute_end_byte",
        "size_bytes",
        "content_sha256",
        "identity_scope"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^win\\.[a-f0-9]{64}$"
        },
        "absolute_start_byte": {
          "type": "integer",
          "minimum": 0
        },
        "absolute_end_byte": {
          "type": "integer",
          "minimum": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "identity_scope": {
          "const": "derived_byte_window_not_parent_book"
        }
      }
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "start_char",
        "end_char",
        "start_in_window_byte",
        "end_in_window_byte",
        "sha256"
      ],
      "properties": {
        "locator": {
          "type": "string",
          "pattern": "^gitblob:[a-f0-9]{40}#char=[0-9]+:[0-9]+$"
        },
        "start_char": {
          "type": "integer",
          "minimum": 0
        },
        "end_char": {
          "type": "integer",
          "minimum": 1
        },
        "start_in_window_byte": {
          "type": "integer",
          "minimum": 0
        },
        "end_in_window_byte": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edition",
        "rights",
        "entailment"
      ],
      "properties": {
        "edition": {
          "const": "not_authenticated"
        },
        "rights": {
          "const": "not_reviewed"
        },
        "entailment": {
          "const": "not_checked"
        }
      }
    },
    "binding_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
