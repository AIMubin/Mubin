{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AIMubin/Mubin/engines/hadith/qualification/H3.9.2/schemas/adjudication-reviewer-registry.schema.json",
  "title": "Mubin H3.9.2 Schema-31 adjudication reviewer registry snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "protocol_freeze_schema",
    "registry_id",
    "snapshot_created_at",
    "reviewers"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "campaign_id": {
      "const": "H3.9.2"
    },
    "protocol_freeze_schema": {
      "const": 31
    },
    "registry_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_created_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewers": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reviewer_id",
          "human",
          "role",
          "qualification_basis",
          "scope",
          "active",
          "conflict_disclosure"
        ],
        "properties": {
          "reviewer_id": {
            "type": "string",
            "minLength": 1
          },
          "human": {
            "const": true
          },
          "role": {
            "enum": [
              "qualified_reviewer",
              "source_verifier",
              "adjudicator"
            ]
          },
          "qualification_basis": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "external-critical-commentary"
              ]
            }
          },
          "active": {
            "type": "boolean"
          },
          "conflict_disclosure": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
