{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://aimubin.org/schemas/h3.9.2-benchmark-record-v4.schema.json",
  "title":"Mubin H3.9.2 qualification benchmark record",
  "type":"object",
  "required":["benchmark_id","case_id","split","source_ids","family_id","content_fingerprint","gold_status","synthetic","source_refs","annotation","payload"],
  "properties":{
    "benchmark_id":{"type":"string","minLength":1},
    "case_id":{"type":"string","minLength":1},
    "split":{"enum":["development","validation","holdout"]},
    "family_id":{"type":"string","minLength":1},
    "content_fingerprint":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "gold_status":{"enum":["reference_pilot","expert_gold"]},
    "synthetic":{"const":false},
    "annotation":{"type":"object","required":["reviewers","source_verified","adjudicated"],"properties":{"reviewers":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"source_verified":{"type":"boolean"},"adjudicated":{"type":"boolean"},"adjudicator":{"type":["string","null"]}},"additionalProperties":true},
    "payload":{"type":"object","required":["input"],"properties":{"input":{},"gold":{"type":"object"},"gold_sealed":{"type":"boolean"}},"additionalProperties":true},
    "source_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "source_refs":{"type":"array","minItems":1,"items":{"type":"object","required":["source_id","locator","source_blob_sha","excerpt","excerpt_sha256"],"properties":{"source_id":{"type":"string","minLength":1},"locator":{"type":"string","minLength":1},"source_blob_sha":{"type":"string","minLength":7},"excerpt":{"type":"string","minLength":1},"excerpt_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"additionalProperties":true}}
  },
  "additionalProperties":true,
  "allOf":[{"if":{"properties":{"split":{"const":"holdout"}},"required":["split"]},"then":{"properties":{"payload":{"required":["input","gold_sealed"],"properties":{"gold_sealed":{"const":true}},"not":{"required":["gold"]}}}},"else":{"properties":{"payload":{"required":["input","gold"]}}}}]
}
